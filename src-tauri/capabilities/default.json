{
  "$schema": "../gen/schemas/desktop-schema.json",
  "description": "Default capabilities for CuentaLibre",
  "identifier": "default",
  "permissions": [
    "core:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-message",
    "notification:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    {
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "$HOME/**"
        }
      ],
      "identifier": "fs:allow-read-file"
    },
    {
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "$HOME/**"
        }
      ],
      "identifier": "fs:allow-write-file"
    },
    {
      "allow": [
        {
          "path": "$APPDATA/**"
        }
      ],
      "identifier": "fs:allow-exists"
    },
    {
      "allow": [
        {
          "path": "$APPDATA/**"
        }
      ],
      "identifier": "fs:allow-mkdir"
    },
    {
      "allow": [
        {
          "path": "$APPDATA/**"
        }
      ],
      "identifier": "fs:allow-remove"
    }
  ],
  "windows": [
    "main"
  ]
}